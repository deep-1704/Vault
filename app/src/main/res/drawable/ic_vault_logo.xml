<?xml version="1.0" encoding="utf-8"?>
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- In-App Logo: The Interlocking Rings / Cryptographic Link -->
    <!-- Ambient Core Glow -->
    <path
        android:pathData="M54,54m-24,0a24,24 0 1,1 48,0a24,24 0 1,1 -48,0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="24">
                <item android:offset="0.0" android:color="#330052FF" />
                <item android:offset="1.0" android:color="#000052FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Ring 2 (Base/Underneath): Deep Cobalt to Electric Violet -->
    <path
        android:fillType="nonZero"
        android:pathData="M62,40 A22,22 0 1,1 62,84 A22,22 0 1,1 62,40 M62,49 A13,13 0 1,0 62,75 A13,13 0 1,0 62,49 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="84"
                android:startY="84"
                android:endX="40"
                android:endY="40">
                <item android:offset="0.0" android:color="#FFC084FC" />
                <item android:offset="0.5" android:color="#FF8B5CF6" />
                <item android:offset="1.0" android:color="#FF0043CE" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Shadow under Ring 1 at Crossing 1 -->
    <path
        android:fillColor="#3D000000"
        android:pathData="M65,37 A23,23 0 0,1 73,45 L69,49 A17,17 0 0,0 61,41 Z" />

    <!-- Ring 1 (Main Over Layer): Vivid Cyan to Deep Cobalt -->
    <path
        android:fillType="nonZero"
        android:pathData="M46,24 A22,22 0 1,1 46,68 A22,22 0 1,1 46,24 M46,33 A13,13 0 1,0 46,59 A13,13 0 1,0 46,33 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="24"
                android:startY="24"
                android:endX="68"
                android:endY="68">
                <item android:offset="0.0" android:color="#FF00F0FF" />
                <item android:offset="0.4" android:color="#FF0066FF" />
                <item android:offset="1.0" android:color="#FF002E99" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular Highlight Crest Rim on Ring 1 -->
    <path
        android:strokeWidth="1.5"
        android:strokeLineCap="round"
        android:pathData="M30,30 A22,22 0 0,1 62,30">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="30"
                android:startY="24"
                android:endX="62"
                android:endY="36">
                <item android:offset="0.0" android:color="#00FFFFFF" />
                <item android:offset="0.4" android:color="#CCFFFFFF" />
                <item android:offset="1.0" android:color="#0000F0FF" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Shadow under Overpass Bridge -->
    <path
        android:fillColor="#59000000"
        android:pathData="M39.5,49 L53.5,83.5 L57.5,79.5 L43.5,45 Z" />

    <!-- Overpass Bridge of Ring 2 -->
    <path
        android:fillType="nonZero"
        android:pathData="M51.0,81.05 A22,22 0 0,1 42.95,51.0 L50.74,55.5 A13,13 0 0,0 55.5,73.26 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="55"
                android:startY="75"
                android:endX="43"
                android:endY="51">
                <item android:offset="0.0" android:color="#FF9B66F7" />
                <item android:offset="1.0" android:color="#FF6366F1" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Specular Highlight on Overpass Bridge -->
    <path
        android:strokeWidth="1.2"
        android:strokeLineCap="round"
        android:pathData="M42.95,51.0 A22,22 0 0,0 51.0,81.05">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="42"
                android:startY="51"
                android:endX="51"
                android:endY="81">
                <item android:offset="0.0" android:color="#80FFFFFF" />
                <item android:offset="0.5" android:color="#20FFFFFF" />
                <item android:offset="1.0" android:color="#60C084FC" />
            </gradient>
        </aapt:attr>
    </path>

</vector>
