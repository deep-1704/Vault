<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Active / Focused state matching new credential input field active border -->
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/vault_input_background" />
            <corners android:radius="24dp" />
            <stroke
                android:width="1.5dp"
                android:color="@color/vault_primary" />
        </shape>
    </item>

    <!-- Default state: solid input field background fill without card stroke -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/vault_input_background" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>
