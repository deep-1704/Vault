<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Solid surface container background -->
    <solid android:color="@color/vault_surface_container" />

    <!-- 12dp rounded corners (DESIGN.md shapes) -->
    <corners android:radius="12dp" />

    <!-- 1px inner stroke using low-opacity white (DESIGN.md secure card border) -->
    <stroke
        android:width="1dp"
        android:color="@color/vault_card_stroke" />

</shape>
