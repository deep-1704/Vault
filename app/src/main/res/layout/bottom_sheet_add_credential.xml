<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout for AddCredentialBottomSheet.
    Wrapped in NestedScrollView so the form is reachable on small screens
    when the soft keyboard is raised.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- Handle bar -->
        <View
            android:layout_width="40dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:background="@color/vault_outline_variant" />

        <!-- Sheet title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:text="@string/add_credential_title"
            android:textAppearance="@style/TextAppearance.Vault.HeadlineSmall"
            android:textColor="@color/vault_on_surface"
            android:textStyle="bold" />

        <!-- Credential type dropdown -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilCredentialType"
            style="@style/Widget.Material3.TextInputLayout.FilledBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp"
            android:hint="@string/add_credential_type_hint"
            app:boxBackgroundColor="@color/vault_input_background"
            app:boxStrokeColor="@color/vault_primary"
            app:boxStrokeWidth="0dp"
            app:boxStrokeWidthFocused="2dp"
            app:hintTextColor="@color/vault_on_surface_variant">

            <AutoCompleteTextView
                android:id="@+id/actvCredentialType"
                style="@style/Widget.Vault.TextInputEditText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:focusable="false"
                android:inputType="none" />

        </com.google.android.material.textfield.TextInputLayout>

        <!-- Dynamic form container — CardFormView or LoginFormView is added here -->
        <FrameLayout
            android:id="@+id/formContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="20dp" />

        <!-- Save & Sync button (Solid Blue) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveAndSync"
            style="@style/Widget.Vault.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:text="@string/btn_save_sync"
            android:visibility="gone"
            tools:visibility="visible" />

        <!-- Save button (Secondary) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSave"
            style="@style/Widget.Vault.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="12dp"
            android:text="@string/btn_save"
            android:visibility="gone"
            tools:visibility="visible" />

    </LinearLayout>

</androidx.core.widget.NestedScrollView>
