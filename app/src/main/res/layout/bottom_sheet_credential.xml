<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <!-- Handle bar -->
    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="12dp"
        android:background="@color/vault_outline_variant"
        android:backgroundTintMode="src_atop" />

    <!-- Entry title -->
    <TextView
        android:id="@+id/tvSheetTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:textAppearance="@style/TextAppearance.Vault.HeadlineSmall"
        android:textColor="@color/vault_on_surface"
        android:textStyle="bold" />

    <!-- Placeholder body -->
    <TextView
        android:id="@+id/tvSheetDetailsPlaceholder"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="12dp"
        android:text="@string/bottom_sheet_details_placeholder"
        android:textAppearance="@style/TextAppearance.Vault.BodyMedium"
        android:textColor="@color/vault_on_surface_variant" />

</LinearLayout>
