<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout for AadhaarFormView.
    Inflated by AadhaarFormView (home/add/AadhaarFormView.kt).
    Fields: Title, Name on Card, Aadhaar Number, Registered Mobile Number.
-->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Title -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTitle"
        style="@style/Widget.Vault.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTitle"
            style="@style/Widget.Vault.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Name on Card -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNameOnCard"
        style="@style/Widget.Vault.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_name_on_card">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNameOnCard"
            style="@style/Widget.Vault.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textPersonName"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Aadhaar Number -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilAadhaarNumber"
        style="@style/Widget.Vault.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_aadhaar_number">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etAadhaarNumber"
            style="@style/Widget.Vault.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="number"
            android:maxLength="12"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Registered Mobile Number -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilMobileNumber"
        style="@style/Widget.Vault.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_mobile_number">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etMobileNumber"
            style="@style/Widget.Vault.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="phone"
            android:maxLength="10"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

</merge>
