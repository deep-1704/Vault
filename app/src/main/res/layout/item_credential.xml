<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@drawable/bg_credential_item"
    android:padding="16dp"
    android:elevation="4dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Component 1: Title + Status Badge (Horizontal align) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="10dp">

        <TextView
            android:id="@+id/tvCredentialTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="start|center"
            android:textAppearance="@style/TextAppearance.Vault.HeadlineMedium"
            android:textColor="@color/vault_on_surface"
            android:textStyle="bold"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Google Workspace" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipStatus"
            style="@style/Widget.Vault.Chip.Status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_gravity="end"
            tools:text="Synced" />

    </LinearLayout>

    <!-- Component 2: Action Buttons (Horizontal align) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSync"
            style="@style/Widget.Vault.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:text="@string/btn_sync"
            app:icon="@drawable/ic_sync"
            app:iconGravity="textStart"
            app:iconSize="18dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnShare"
            style="@style/Widget.Vault.Button.Secondary"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:text="@string/btn_share"
            app:icon="@drawable/ic_share"
            app:iconGravity="textStart"
            app:iconSize="18dp" />

    </LinearLayout>

</LinearLayout>
