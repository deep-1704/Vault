<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout for PanFormView.
    Inflated by PanFormView (home/add/PanFormView.kt).
    Fields: Title, PAN Number, Name on Card.
-->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Title -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilTitle"
        style="@style/Widget.Vault.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_title">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etTitle"
            style="@style/Widget.Vault.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="text"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- PAN Number -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilPanNumber"
        style="@style/Widget.Vault.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_pan_number">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etPanNumber"
            style="@style/Widget.Vault.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionNext"
            android:inputType="textCapCharacters"
            android:maxLength="10"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

    <!-- Name on Card -->
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/tilNameOnCard"
        style="@style/Widget.Vault.TextInputLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:hint="@string/hint_name_on_card">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/etNameOnCard"
            style="@style/Widget.Vault.TextInputEditText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:imeOptions="actionDone"
            android:inputType="textPersonName"
            android:singleLine="true" />

    </com.google.android.material.textfield.TextInputLayout>

</merge>
